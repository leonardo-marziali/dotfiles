theme = Catppuccin Mocha

font-family = "Fira Code Retina"
font-size = 14

background-opacity = 0.95

# Remap command+s to send Ctrl+s for tmux
keybind = cmd+s=text:\x13

# Disable some default keybindings for tab managment that interfere with tmux
keybind = cmd+t=ignore
keybind = shift+cmd+d=ignore

# Vim motion remappings - Cmd to Ctrl
# Ctrl-D (scroll down half page)
keybind = cmd+d=text:\x04
# Ctrl-U (scroll up half page)
keybind = cmd+u=text:\x15
# Ctrl-F (scroll down full page)
keybind = cmd+f=text:\x06
# Ctrl-B (scroll up full page)
keybind = cmd+b=text:\x02
# Ctrl-O (jump to older position)
keybind = cmd+o=text:\x0f
# Ctrl-I (jump to newer position)
keybind = cmd+i=text:\x09
# Ctrl-E (scroll down one line)
keybind = cmd+e=text:\x05
# Ctrl-Y (scroll up one line)
keybind = cmd+y=text:\x19
# Ctrl-G (show file status)
keybind = cmd+g=text:\x07

# Remap command+p to send Ctrl+p for Telescope in Neovim
keybind = cmd+p=text:\x10

# Remap command+n to send Ctrl+n for Neotree in Neovim
keybind = cmd+n=text:\x0e

# Set default shell to fish
command = /opt/homebrew/bin/fish --login --interactive
